<?xml version="1.0" encoding="UTF-8"?>
<cloudiac:Infrastructure
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:cloudiac="http://www.example.org/cloudiac"
    xsi:schemaLocation="http://www.example.org/cloudiac platform:/resource/Coursework%202/cloudiac/model/cloudiac.ecore"
    xmi:id="infra1">
  <resource
      xsi:type="cloudiac:ComputeInstance"
      xmi:id="ci1"
      name="DatabaseServer"
      CPU="8"
      memoryGB="32"
      osImage="AMAZON_LINUX"
      subnet="sub2"
      vpc="vpc1"
      network="net1">
    <region>London</region>
    <region>Manchester</region>
  </resource>
  <resource
      xsi:type="cloudiac:StorageBucket"
      xmi:id="sb1"
      name="UserUploadsCloudiac"
      versioning="true"/>
  <resource
      xsi:type="cloudiac:Network"
      xmi:id="net1"
      name="MainCluster"
      cidr="10.0.0.0/16">
    <vpc xmi:id="vpc1"
        cidr="10.0.0.0/16">
      <subnet
          xmi:id="sub1"
          name="Frontend"
          cidr="10.0.3.0/24">
        <region>London</region>
      </subnet>
      <subnet
          xmi:id="sub2"
          name="Backend"
          cidr="10.0.2.0/24">
        <region>Manchester</region>
        <region>Birmingham</region>
      </subnet>
    </vpc>
    <hostedzone
        xmi:id="hz1"
        name="CloudiacZone"
        domain="cloudiac.com"/>
  </resource>
  <resource
      xsi:type="cloudiac:ComputeInstance"
      name="FrontEndServer"
      CPU="8"
      memoryGB="32"
      osImage="AMAZON_LINUX"
      subnet="sub1"
      vpc="vpc1"
      network="net1">
    <region>London</region>
  </resource>
  <resource
      xsi:type="cloudiac:ComputeInstance"
      name="BackEndServer"
      CPU="8"
      memoryGB="32"
      subnet="sub2"
      vpc="vpc1"
      network="net1">
    <region>London</region>
  </resource>
</cloudiac:Infrastructure>